@page "/usuarios"
@using sharpness_sharp.Components.UIComponents
<div class="flex flex-col gap-2">
    @foreach (Usuario user in lstUsuarios)
    {
        <div class="border ">
            <h2>Username: @user.Nombre @user.Apellido</h2>
            <p>Color: @user.Color_Piel</p>
            <p>Email: @user.Email</p>
            <p>Password: @user.Password</p>
            <p>Estatura: @user.Estatura</p>
            <p>Fecha de Nacimiento: @user.Fecha_Nac</p>
        </div>

        <CoffeeCard Imagen="imagen.jpg" DescripcionCafe="jfdskljflkds" NombreCafe="klfdsjafkljdslkfjdas" PrecioCafe="20">
        </CoffeeCard>
    }
</div>

